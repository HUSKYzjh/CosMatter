# Copy these fields into the protected workspace-level ../.env and fill values locally. Do not commit it.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=high
DEEPSEEK_API_KEY=

# Sciverse Agent Tools uses this name. Legacy SCIVERSE_API_KEY is accepted only
# as a local fallback for compatibility with older templates.
SCIVERSE_API_TOKEN=
SCIVERSE_BASE_URL=https://api.sciverse.space
# Optional paper-structure and bibliographic metadata services
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
CROSSREF_MAILTO=
CROSSREF_BASE_URL=https://api.crossref.org

HTTP_TIMEOUT_SECONDS=60
API_MAX_RETRIES=3
API_LOG_REQUEST_IDS_ONLY=true
