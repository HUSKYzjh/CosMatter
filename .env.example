# Copy values from the workspace .env. Do not commit the resulting .env file.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Sciverse Agent Tools uses this name. Legacy SCIVERSE_API_KEY is accepted only
# as a local fallback for compatibility with older templates.
SCIVERSE_API_TOKEN=
SCIVERSE_BASE_URL=https://api.sciverse.space

HTTP_TIMEOUT_SECONDS=60
API_MAX_RETRIES=3
API_LOG_REQUEST_IDS_ONLY=true
