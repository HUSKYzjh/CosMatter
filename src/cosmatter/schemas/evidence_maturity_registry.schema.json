{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmatter.local/schemas/evidence-maturity-registry/v1",
  "title": "CosMatter evidence maturity registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "question_id", "trust_status", "claims"],
  "properties": {
    "schema_version": {"const": "cosmatter.evidence-maturity-registry/v1"},
    "registry_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "question_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "trust_status": {"enum": ["blank_human_evidence_maturity_registry_template_not_evidence", "delegated_automated_trial_evidence_maturity_registry_not_scientific_evidence", "human_reviewed_evidence_maturity_registry_not_scientific_conclusion"]},
    "claims": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_text", "maturity_level", "assessment_authority", "support_records", "reproducibility", "independent_reproduction", "limitations"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "claim_text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "maturity_level": {"enum": ["literature_mentioned", "data_supported", "reproducibility_ready", "independently_reproduced"]},
        "assessment_authority": {"enum": ["unreviewed", "delegated_automated_trial", "human_source_review", "human_data_review", "human_reproducibility_review", "independent_reproduction_review"]},
        "support_records": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/support"}},
        "reproducibility": {"$ref": "#/$defs/reproducibility"},
        "independent_reproduction": {"$ref": "#/$defs/reproduction"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "maxItems": 30}
      },
      "allOf": [
        {
          "if": {"properties": {"assessment_authority": {"const": "delegated_automated_trial"}}, "required": ["assessment_authority"]},
          "then": {"properties": {"maturity_level": {"const": "literature_mentioned"}}}
        },
        {
          "if": {"properties": {"maturity_level": {"const": "data_supported"}}, "required": ["maturity_level"]},
          "then": {"properties": {"assessment_authority": {"enum": ["human_data_review", "human_reproducibility_review", "independent_reproduction_review"]}}}
        },
        {
          "if": {"properties": {"maturity_level": {"enum": ["data_supported", "reproducibility_ready", "independently_reproduced"]}}, "required": ["maturity_level"]},
          "then": {"properties": {"support_records": {"contains": {"type": "object", "properties": {"source_map_status": {"const": "human_reviewed"}, "data_status": {"const": "numeric_or_figure_data_human_checked"}, "conditions_status": {"const": "complete_human_checked"}, "stance": {"enum": ["supports", "contradicts", "mixed"]}}, "required": ["source_map_status", "data_status", "conditions_status", "stance"]}}}}
        },
        {
          "if": {"properties": {"maturity_level": {"const": "reproducibility_ready"}}, "required": ["maturity_level"]},
          "then": {"properties": {"assessment_authority": {"enum": ["human_reproducibility_review", "independent_reproduction_review"]}, "reproducibility": {"properties": {"assessment": {"const": "reproducibility_ready_human_reviewed"}}, "required": ["assessment"]}}}
        },
        {
          "if": {"properties": {"maturity_level": {"const": "independently_reproduced"}}, "required": ["maturity_level"]},
          "then": {"properties": {"assessment_authority": {"const": "independent_reproduction_review"}, "independent_reproduction": {"properties": {"status": {"const": "replicated"}, "independent_run_id": {"type": "string", "minLength": 1, "maxLength": 160}, "result_comparison": {"const": "within_predefined_tolerance"}, "review_status": {"const": "human_reviewed"}}, "required": ["status", "independent_run_id", "result_comparison", "review_status"]}}}
        }
      ]
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "document_id", "document_version", "independence_group", "source_map_status", "data_status", "conditions_status", "stance"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
        "document_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "document_version": {"enum": ["publisher_version", "accepted_manuscript", "preprint", "unknown", "publisher_open_access_mirror_version_not_human_verified"]},
        "independence_group": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_map_status": {"enum": ["none", "automated_trial_only", "human_reviewed"]},
        "data_status": {"enum": ["not_checked", "narrative_only", "numeric_or_figure_data_human_checked"]},
        "conditions_status": {"enum": ["not_checked", "partial", "complete_human_checked"]},
        "stance": {"enum": ["supports", "contradicts", "mixed", "boundary_counterexample", "context_only"]}
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_status", "materials_status", "measurement_status", "raw_data_status", "assessment"],
      "properties": {
        "protocol_status": {"enum": ["not_checked", "partial", "complete_human_checked"]},
        "materials_status": {"enum": ["not_checked", "partial", "complete_human_checked"]},
        "measurement_status": {"enum": ["not_checked", "partial", "complete_human_checked"]},
        "raw_data_status": {"enum": ["not_checked", "available", "not_available", "not_required"]},
        "assessment": {"enum": ["not_assessed", "insufficient", "reproducibility_ready_human_reviewed"]}
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "independent_run_id", "result_comparison", "review_status"],
      "properties": {
        "status": {"enum": ["not_attempted", "planned", "in_progress", "replicated", "not_replicated", "inconclusive"]},
        "independent_run_id": {"type": ["string", "null"], "maxLength": 160},
        "result_comparison": {"enum": ["not_available", "within_predefined_tolerance", "outside_predefined_tolerance", "inconclusive"]},
        "review_status": {"enum": ["not_reviewed", "human_reviewed"]}
      }
    }
  }
}
